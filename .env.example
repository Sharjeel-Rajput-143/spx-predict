# --- Signal Automation Engine (Phase 1) ---
# Copy to .env.local and fill in. None of this affects the prediction game,
# which needs no configuration.

# Shared secret TradingView puts in the webhook body (it can't send custom
# headers). Required, no default.
WEBHOOK_SECRET=

# Password for the automation pages (it guards the bot kill switch). Optional
# for local development - leave it blank and there is no sign-in. A production
# build refuses all access if this is not set, so set it before deploying.
AUTOMATION_STATUS_PASSWORD=
# With no password a production build is open (a demo: mock executor only, with a warning on every page); once
# EXECUTOR=tradier is set, a missing password means access is denied. AUTOMATION_AUTH_DISABLED=true switches sign-in
# off on purpose even then - ignored (sign-in stays on) when real money is in play (TRADIER_ALLOW_PRODUCTION=true).
# AUTOMATION_AUTH_DISABLED=true

# Decision engine tuning - every one of these has the spec's default and is
# safe to leave unset.
# DEDUPE_WINDOW_SECONDS=120
# MAX_POSITIONS_PER_TYPE=1
# TOTAL_POSITION_LIMIT=1
# DAILY_NEW_POSITION_LIMIT=10
# ERROR_FAILSAFE_THRESHOLD=10
# ORDER_FILL_TIMEOUT_SECONDS=120
# CLOSE_CONFIRM_TIMEOUT_SECONDS=120
# AUTOMATION_DRY_RUN=false

# Trading window (weekdays, America/New_York, inclusive). HH:MM, 24h.
# AUTOMATION_HOURS_START=09:35
# AUTOMATION_HOURS_END=15:55

# Minimum seconds a position must be held before a flip may close it.
# 0 (default) = off. Cuts whipsaw losses on choppy days if you want it.
# FLIP_COOLDOWN_SECONDS=0

# --- Bot: spx_ema_bias ---
# Hidden for now (archived and off; Settings > Bot Archive > Restore brings it back). BOT_SPX_EMA_BIAS_HIDDEN=false shows it from the start.
# BOT_SPX_EMA_BIAS_HIDDEN=true
# Quantity, width and strike increment are the real values from the spec and
# ship as defaults below - override only if the live bot's settings changed.
# BOT_SPX_EMA_BIAS_QUANTITY=3
# BOT_SPX_EMA_BIAS_WIDTH_POINTS=5
# BOT_SPX_EMA_BIAS_STRIKE_INCREMENT=5
# BOT_SPX_EMA_BIAS_ALLOCATION_LIMIT=20000

# The short strike's distance from the signal price, in signed points (decimals are
# fine). The defaults are the live Option Alpha SPX bot's: 0.01 beyond the price, so
# the short strike lands on the first strike at or beyond it. Set to override.
# BOT_SPX_EMA_BIAS_PUT_SHORT_OFFSET=-0.01
# BOT_SPX_EMA_BIAS_CALL_SHORT_OFFSET=0.01
# How that target is snapped onto the strike grid. outward (default): the short put
# rounds DOWN and the short call rounds UP (the out-of-the-money side). nearest: the
# closest strike. TODO(unconfirmed): verify "outward" against Option Alpha's behavior.
# BOT_SPX_EMA_BIAS_STRIKE_ROUNDING=outward
# The order price as a percent of the bid/ask (Option Alpha: "100% of bid/ask").
# TODO(unconfirmed): the exact meaning - confirm with the owner.
# BOT_SPX_EMA_BIAS_OPEN_PRICE_PERCENT=100
# BOT_SPX_EMA_BIAS_CLOSE_PRICE_PERCENT=100
# SmartPricing preset: normal (default, the live bot's: up to 4 prices, 10s each), fast, patient or off.
# Only used when the executor can quote the spread (Tradier); the mock sends one price.
# BOT_SPX_EMA_BIAS_SMART_PRICING=normal
# The live bot holds up to 3 positions.
# BOT_SPX_EMA_BIAS_TOTAL_POSITION_LIMIT=3

# TODO: ask Sharjeel for the real expected opening credit per spread. Phase 1
# has no option chain, so this is what the engine uses as the opening order's
# limit price and as the pre-trade allocation-limit estimate. The spec's
# $2.20 is given only as "example from our current bot," not a confirmed
# live value - do not treat it as the default.
BOT_SPX_EMA_BIAS_OPENING_CREDIT_ESTIMATE=

# Demo only: make the mock executor report made-up close prices so the P/L
# screens have something to show. Every P/L figure is then fictional (the bot
# page says so). Leave unset - with no pricing, P/L stays blank rather than guessed.
# AUTOMATION_MOCK_PRICING=simulated

# --- Bot: ndx_ema_bias (Nasdaq 100, same EMA 9/20 bias as SPX) ---
# Works with NO settings: a second built-in bot driven by the same engine and webhook. Everything below is an
# optional override. Send "bot":"ndx_ema_bias","symbol":"NDX" from the NDX alerts (or use a named webhook).
# BOT_NDX_EMA_BIAS_QUANTITY=1
# BOT_NDX_EMA_BIAS_WIDTH_POINTS=10
# BOT_NDX_EMA_BIAS_ALLOCATION_LIMIT=2000
# BOT_NDX_EMA_BIAS_ACCOUNT_ID=paper-ndx
# Short-strike offsets (default -0.01 / +0.01, mirroring the live SPX bot), rounding, order price % of bid/ask, SmartPricing:
# BOT_NDX_EMA_BIAS_PUT_SHORT_OFFSET=-0.01
# BOT_NDX_EMA_BIAS_CALL_SHORT_OFFSET=0.01
# BOT_NDX_EMA_BIAS_STRIKE_ROUNDING=outward
# BOT_NDX_EMA_BIAS_OPEN_PRICE_PERCENT=100
# BOT_NDX_EMA_BIAS_CLOSE_PRICE_PERCENT=100
# BOT_NDX_EMA_BIAS_SMART_PRICING=normal
# BOT_NDX_EMA_BIAS_TOTAL_POSITION_LIMIT=1
# Strike spacing near the money (default 5; scripts/tradier-sandbox-probe.ts prints the real one), the series root,
# the fallback credit used only when there is no live quote (the mock) and for the pre-trade risk check, and when
# positions are marked expired (default 16:15 ET):
# BOT_NDX_EMA_BIAS_STRIKE_INCREMENT=5
# BOT_NDX_EMA_BIAS_OPTION_ROOT=NDXP
# BOT_NDX_EMA_BIAS_OPENING_CREDIT_ESTIMATE=3.5
# BOT_NDX_EMA_BIAS_EOD_SWEEP_TIME=16:15
# Optional sanity range for the signal's price (set both ends to turn it on):
# BOT_NDX_EMA_BIAS_PRICE_MIN=
# BOT_NDX_EMA_BIAS_PRICE_MAX=
# Own signal window (HH:MM ET); unset = the global 09:35-15:55:
# BOT_NDX_EMA_BIAS_HOURS_START=09:35
# BOT_NDX_EMA_BIAS_HOURS_END=15:55

# --- Executor (who places the orders) ---
# mock (the default): nothing reaches a broker; every trade is labelled TEST.
# tradier: IMPLEMENTED BUT DISABLED - not connected to any account and never run
# against the real API. It defaults to Tradier's SANDBOX and refuses to start
# without a token and account id. See docs/tradier-executor-research.md.
# EXECUTOR=mock
# TRADIER_TOKEN=
# TRADIER_ACCOUNT_ID=
# Defaults to the sandbox, https://sandbox.tradier.com/v1. The production URL
# (https://api.tradier.com/v1) is refused unless BOTH it and the flag below are set,
# and that needs the owner's approval first.
# TRADIER_BASE_URL=
# TRADIER_ALLOW_PRODUCTION=true
# REQUIRED for production, no defaults (optional in the sandbox): the most contracts, and the most dollars
# at risk (width x 100 x contracts - credit), any ONE opening order may carry. Closing is never capped.
# TRADIER_MAX_CONTRACTS_PER_ORDER=
# TRADIER_MAX_RISK_PER_ORDER=
# Optionally compare our open positions with the broker's every N minutes (0 = off; the Check button always works).
# RECONCILE_INTERVAL_MINUTES=0

# --- Testing mode ---
# Lets the admin page's "Send test alert" run outside trading hours (the clock
# check is skipped and the trace says so). Real webhook alerts are never
# affected. Leave off outside demos.
# AUTOMATION_TEST_MODE=true
# How often an order is checked for its fill; the demo feels snappier at 300.
# AUTOMATION_ORDER_POLL_INTERVAL_MS=2000

# --- Activity alerts ---
# Opened, closed, warning and error alerts always show on the Automation status page
# (each bot switches the four kinds on/off under Settings > Alerts; all on by default).
# Email is OPTIONAL and OFF unless both of these are set. TODO(owner): no mail sender is
# wired yet - which provider to use is undecided - so enabling it only queues each alert.
# ALERT_EMAIL_ENABLED=true
# ALERT_EMAIL_TO=

# --- NDX on Tradier's sandbox (paper money) ---
# See docs/ndx-paper-trading-setup.md. The probe script prints the real strike spacing, option root and symbol format:
#   set -a; . ./.env.local; set +a; node --experimental-strip-types scripts/tradier-sandbox-probe.ts
# BOT_NDX_EMA_BIAS_OPTION_ROOT=NDXP
